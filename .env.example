# ==========================================
# QUICKSHOW Environment Variables Template (.env.example)
# Copy this file to .env and fill in your real values locally.
# NEVER put real secret keys in .env.example or commit .env to Git!
# ==========================================

# Server Port (3000 for single-port preview/production, 5000 when running client+server separately in VS Code)
PORT=3000

# MongoDB Connection String (MongoDB Atlas -> Connect -> Drivers, or local MongoDB)
MONGODB_URI=

# Clerk Authentication (https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Admin Authorization (comma-separated admin email addresses; also supports Clerk publicMetadata.role = "admin")
ADMIN_EMAILS=

# TMDB Movie API (https://www.themoviedb.org/settings/api -> API Read Access Token or API Key)
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Payment Mode ("dev_simulated" or "razorpay_test")
PAYMENT_MODE=dev_simulated

# Razorpay Payment Gateway - Optional Test Mode (https://dashboard.razorpay.com -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Inngest Event Sync (https://app.inngest.com)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Frontend Settings
VITE_CURRENCY=₹
VITE_API_URL=