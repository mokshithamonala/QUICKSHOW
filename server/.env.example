## Copy this to .env and fill your values

# MongoDB (create free cluster at cloud.mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/quickshow?retryWrites=true&w=majority

# TMDB API (get Bearer token at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=eyJhbGciOiJIUzI1NiJ9...

# Inngest (sign up at inngest.com)
INNGEST_EVENT_KEY=ihs_xxxxxxxx

# Clerk (sign up at clerk.com)
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

